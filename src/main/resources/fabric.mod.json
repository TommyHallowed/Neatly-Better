{
	"schemaVersion": 1,
	"id": "old-ways",
	"version": "${version}",
    "accessWidener": "old-ways.accesswidener",
	"name": "The Old Ways",
	"description": "A minecraft mod that brings balance and enjoynment of the old versions of the game while fixing & improving upon existing features.",
	"authors": [
		"Hallowed103"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/old-ways/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "net.hallowed.TheOldWays"
		],
		"client": [
          "net.hallowed.TheOldWaysClient"
		],
        "elytratrims-client": [
          "net.hallowed.oldways.client.compat.ElytraTrimsCompat"
        ]
	},
	"mixins": [
      "old-ways.mixins.json",
      "old-ways.client.mixins.json",
		"old-ways-compat.mixins.json"
    ],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
      "suggests": {
          "elytratrims": "*",
          "backpacked": "*"
      }
}